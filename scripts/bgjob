#!/usr/bin/env python3
"""Detached background jobs for work that outlives a bot turn.

The bot runs ONE CLI process per turn and unconditionally disconnects when the
reply is sent (src/claude/sdk_integration.py, `finally: client.disconnect()`),
so a backgrounded sub-agent is always killed mid-flight. Blocking sub-agents
work fine but the whole turn is capped at CLAUDE_TIMEOUT_SECONDS (300s).

This runs the work OUTSIDE the turn instead: `systemd-run --user` starts a
transient unit that is not a child of the bot, so it survives both the end of
the turn and a bot restart (the user manager has Linger=yes). Completion pings
Telegram via `scripts/agentctl notify`.
Without systemd (macOS, WSL2; `DEVVY_LAUNCHER=process`) the job runs detached
under src/platform/launcher.py's supervisor instead, and agent jobs are boxed
by sandbox-exec where there is no bwrap (dv-fe4d).

NOTE on output: `claude --output-format text` buffers the whole reply and only
writes it when the run ends, so `output.md` stays 0 bytes while the job works
and a crash loses it entirely. Progress is therefore reported from the cgroup
(CPU/memory/elapsed), and any job that must survive a crash has to be told, in
its prompt, to write its findings to files incrementally.

Usage:
  bgjob run "<prompt>" [--profile general] [--name research]
  bgjob run --cmd "<shell command>" [--name N] [--cwd DIR]  (no model call)
  bgjob run --task dv-xxxx "<short instruction>"   (job reads the ticket)
  bgjob run "<prompt>" --pre-cmd "<shell>" --pre-log F [--pre-timeout S]
                                       (command to completion, then the turn)
  bgjob list [--compact] [--limit N]
  bgjob status <id>
  bgjob output <id> [--tail N | --full]   (default: summary.md)
  bgjob summarize <id>
  bgjob cancel <id>
  bgjob digest <id>   (batch digest check; run by a finishing job)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import UTC, datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))
from src.utils.job_scope import cwd_in_profile  # noqa: E402

JOBS_ROOT = Path(os.environ.get("BGJOB_ROOT", REPO.parent / "jobs"))
PROFILES_YAML = REPO / "config" / "profiles.yaml"
AGENTCTL = REPO / "scripts" / "agentctl"
HOME_TASKS = REPO / ".deviz" / "tasks"
PREAMBLE = REPO / "templates" / "bgjob_preamble.md"

SUMMARY_LINES = 15
SUMMARY_CHARS = 1500
_SUMMARY_RE = re.compile(r"<summary>(.*?)</summary>", re.DOTALL)

# Conservative defaults for small hosts (this host had 3.8G when it once
# OOM-rebooted from parallel claude processes; it has 11G now). Bigger hosts
# raise them via BGJOB_MAX_CONCURRENT / BGJOB_MEMORY_MAX in the environment of
# the bot and pump2 units.
MAX_CONCURRENT = int(os.environ.get("BGJOB_MAX_CONCURRENT", "2"))
JOB_MEMORY_MAX = os.environ.get("BGJOB_MEMORY_MAX", "1G")
# scripts/testrun's cap (unset = its 1500M); an agent job's unit holds both.
TEST_MEMORY_MAX = os.environ.get("PUMP_TEST_MEMORY_MAX", "")
# What agentjob reads to resolve the job's route (dv-d63d): the route table's
# path and the legacy per-stage models (src/model_router/routes.py
# LEGACY_JOB_ENV_NAMES), forwarded into the transient unit.
ROUTE_ENV = (
    "MODEL_ROUTES_PATH",
    "PUMP_ACCEPTANCE_MODEL",
    "PUMP_ANALYZE_MODEL",
    "PUMP_ARCHITECT_MODEL",
    "PUMP_IMPLEMENT_MODEL",
    "PUMP_REVIEW_MODEL",
    "PUMP_TESTDESIGN_MODEL",
)

# An agent job's --pre-cmd step (dv-2514): default timeout, and the grace
# between timeout's TERM and its KILL (acceptance.py tears down on TERM).
PRE_TIMEOUT_S = 3600
PRE_KILL_AFTER_S = 120

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def _src_module(rel: str, name: str):
    """A stdlib-only module of src/ by file path: this script runs on the
    system python, which has none of the package's dependencies."""
    import importlib.util

    spec = importlib.util.spec_from_file_location(name, REPO / rel)
    assert spec and spec.loader
    mod = importlib.util.module_from_spec(spec)
    # Registered before exec: a module declaring a dataclass (paths.py) is
    # looked up in sys.modules while the class body runs.
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


# systemd unit or detached supervised process (dv-fe4d); see the module.
launcher = _src_module("src/platform/launcher.py", "_bgjob_launcher")


def _env() -> dict:
    """systemd --user needs XDG_RUNTIME_DIR; the bot's environment lacks it."""
    env = dict(os.environ)
    env["XDG_RUNTIME_DIR"] = RUNTIME_DIR
    return env


_SIZE_UNITS = {"": 1, "K": 2**10, "M": 2**20, "G": 2**30, "T": 2**40}


def _quota():
    """src/model_router/quota.py (stdlib only), or None if it cannot load: the
    usage-limit record must never be what stops bgjob (dv-7ad9)."""
    if str(REPO) not in sys.path:
        sys.path.insert(0, str(REPO))
    try:
        from src.model_router import quota
    except Exception:
        return None
    return quota


def record_job_limit(job_id: str) -> None:
    """A job that ended on a usage limit (agentjob exit QUOTA_EXIT plus its
    quota line) records it, so every later model job, the pump's included,
    knows the limit is out until the reset. Any job's agentjob usage line
    (last Claude subscription usage, dv-55ad) is recorded whatever the exit:
    the job's box cannot write the record itself."""
    quota = _quota()
    if quota is None:
        return
    d = job_dir(job_id)
    try:
        rc = int((d / "exit_code").read_text().strip())
        err = (d / "stderr.log").read_text(encoding="utf-8", errors="replace")
    except (OSError, ValueError):
        return
    source = f"bgjob:{read_meta(job_id).get('name') or job_id}"
    usage = quota.find_usage(err[-8000:])
    if usage is not None:
        quota.record_usage(usage[0], source, usage[1])
    if rc != quota.QUOTA_EXIT:
        return
    limit = quota.find_limit(err[-8000:], datetime.now(UTC))
    if limit is not None:
        quota.record(limit, source)


def cmd_limit_notice(args: argparse.Namespace) -> int:
    """run.sh, after `summarize`, for a job that exited QUOTA_EXIT: the one
    concise notice of the limit in the chat of the agent whose job hit it
    (dv-47f9), shared with the pump's notices (one per provider, reset and
    chat). A quiet job (the pump's) is the pump's to tell; the Jobs ping
    still says "stopped on usage limit" as before."""
    quota = _quota()
    meta = read_meta(args.id)
    profile = meta.get("profile") or ""
    if quota is None or meta.get("quiet") or not profile:
        return 0
    try:
        err = (job_dir(args.id) / "stderr.log").read_text(
            encoding="utf-8", errors="replace"
        )
    except OSError:
        return 0
    limit = quota.find_limit(err[-8000:], datetime.now(UTC))
    if limit is None:
        return 0
    provider = quota.provider_of(limit.provider)
    # The recorded limit: a later reset than this job's own wins (same key
    # the pump uses).
    limit = quota.active(provider=provider) or limit
    who = f"{provider} (Codex)" if provider == "openai" else provider
    text = (
        f"⏸ лимит {who} кончился до {limit.until.astimezone(UTC):%H:%M} UTC: "
        f"задачи на нём ждут сброса, остальные модели идут\n{limit.message[:80]}"
    )

    def deliver() -> bool:
        cmd = [str(AGENTCTL), "notify", text, "--source", "bgjob"]
        cmd += ["--profile", profile, "--deliver"]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return False
        return r.returncode == 0

    quota.notify_once(limit, profile, deliver)
    return 0


def refuse_on_limit(args: argparse.Namespace | None = None) -> None:
    """Exit if a usage limit is recorded and not reset yet: a model job
    started now would only hit it (dv-7ad9). --force skips this."""
    quota = _quota()
    provider = "anthropic"
    if args is not None:
        cmd = [_venv_python(), str(REPO / "scripts" / "agentjob"), "--print-route"]
        if getattr(args, "route", None):
            cmd += ["--route", args.route]
        if getattr(args, "model", None):
            cmd += ["--model", args.model]
        try:
            probe = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            if probe.returncode == 0:
                provider = json.loads(probe.stdout or "{}").get("provider") or provider
        except (OSError, subprocess.SubprocessError, ValueError, TypeError):
            pass
    if provider == "anthropic_sub":
        provider = "anthropic"
    limit = quota.active(provider=provider) if quota is not None else None
    if limit is not None:
        sys.exit(
            f"error: {provider} usage limit exhausted until "
            f"{limit.until.strftime('%H:%M UTC')} ({limit.message[:120]}); "
            f"--force to try anyway"
        )


def _size_bytes(size: str) -> int | None:
    """A systemd size ("1G", "1500M", "2048") in bytes; None for anything else
    ("infinity", "50%")."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([KMGT]?)B?", size.strip())
    return int(float(m.group(1)) * _SIZE_UNITS[m.group(2)]) if m else None


def agent_unit_memory_max() -> str:
    """An agent job's unit cap. scripts/testrun puts the job's tests in their
    own cgroup INSIDE the unit (dv-5e2f), so the unit holds the agent's cap
    plus the test cap; the agent's own share is box/agent/memory.max."""
    job = _size_bytes(JOB_MEMORY_MAX)
    test = _size_bytes(TEST_MEMORY_MAX or "1500M")
    if job is None or test is None:
        return JOB_MEMORY_MAX
    return str(job + test)


def tui_secret_file() -> Path:
    """The local TUI's credential (dv-fe4d), which no job may read: it alone
    answers an owner prompt, so a job holding it could approve its own ask.
    (The job does read bot.env: that is where agentctl's bearer lives.)"""
    paths = _src_module("src/utils/paths.py", "_bgjob_paths")
    return paths.tui_secret_path()


def job_box_prefix(bwrap_bin: str, write_paths: list[str]) -> str:
    """The bwrap argv an agent job runs in: / read-only, write_paths rw.

    `--ro-bind / /` alone leaves the user bus connectable (a read-only mount
    does not stop connect() on a unix socket), and through it
    `systemd-run --user` starts a service OUTSIDE the box with / writable
    (dv-5e2f). So the runtime dir is a private empty tmpfs and the bus address
    is unset. No bind may land under /run/user after the tmpfs. `$box_cg` is
    run.sh's bind of the job's delegated cgroup (empty without delegation)."""
    uid = os.getuid()
    run_user = f"/run/user/{uid}" if Path(f"/run/user/{uid}").is_dir() else "/run/user"
    binds = " ".join(f"--bind {shlex.quote(w)} {shlex.quote(w)}" for w in write_paths)
    return (
        f"{shlex.quote(bwrap_bin)} --ro-bind / / --tmpfs {run_user} "
        f"--unsetenv DBUS_SESSION_BUS_ADDRESS {binds} $box_cg "
        f"--bind /tmp /tmp --dev /dev --proc /proc --die-with-parent"
    )


def bwrap_hide_args(hidden: list[str]) -> str:
    """bwrap options that cover each existing *hidden* file with /dev/null.
    Appended after job_box_prefix, so no bind before them exposes it again.
    A file that does not exist yet needs no cover (and bwrap could not
    create the mount point on the read-only /)."""
    return "".join(
        f" --ro-bind /dev/null {shlex.quote(h)}" for h in hidden if Path(h).is_file()
    )


def seatbelt_box_prefix(sandbox_exec: str, d: Path, write_paths: list[str]) -> str:
    """The macOS job box (dv-fe4d): sandbox-exec with the job profile of
    src/security/seatbelt.py, written to the job dir. Same contract as
    job_box_prefix: reads everywhere, writes only write_paths, and no
    launchd/LaunchServices/AppleEvents escape (the dv-5e2f analogue)."""
    seatbelt = _src_module("src/security/seatbelt.py", "_bgjob_seatbelt")
    profile = d / "box.sb"
    profile.write_text(
        seatbelt.job_profile(write_paths, hidden=[str(tui_secret_file())]),
        encoding="utf-8",
    )
    return f"{shlex.quote(sandbox_exec)} -f {shlex.quote(str(profile))}"


def job_box(d: Path, write_paths: list[str]) -> str:
    """The run.sh prefix that boxes an agent job: bwrap where it exists,
    else macOS sandbox-exec. Neither: refuse, never run unconfined."""
    bwrap_bin = shutil.which("bwrap")
    if bwrap_bin:
        return job_box_prefix(bwrap_bin, write_paths) + bwrap_hide_args(
            [str(tui_secret_file())]
        )
    sandbox_exec = shutil.which("sandbox-exec")
    if sandbox_exec:
        return seatbelt_box_prefix(sandbox_exec, d, write_paths)
    sys.exit(
        "error: no box tool (bwrap or sandbox-exec) found; "
        "refusing to run a job unconfined"
    )


def pre_step_lines(d: Path, bwrap_prefix: str, pre: dict) -> str:
    """run.sh lines for an agent job's pre-agent command step (dv-2514).

    pump2 runs a board's acceptance command this way: the agent's Bash
    tool stops at 600 s, a full suite does not. The command runs in the same
    box as the agent (it is code the build wrote), output to pre["log"],
    under `timeout`, which signals its whole process group. A finished step,
    any exit code, hands over to the agent: failing scenarios are the agent's
    to judge. Past the timeout it is a hang: `pre_timed_out`, exit_code 124,
    no agent turn. An exit 124 of the command itself before the timeout is
    not a hang, hence the elapsed check. The `if` opened here is closed after
    the agent line by cmd_run."""
    log = shlex.quote(pre["log"])
    secs = int(pre["timeout"])
    return (
        f"mkdir -p {shlex.quote(str(Path(pre['log']).parent))}\n"
        "pre_t0=$(date +%s)\n"
        f"timeout --kill-after={PRE_KILL_AFTER_S} {secs} {bwrap_prefix} "
        # The unit's PATH is minimal; the step's tools (taskset, poetry) are
        # where the --cmd runner finds them.
        'env PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH" '
        f'/bin/bash -c "$(cat {str(d / "pre_cmd.txt")!r})" '
        f"> {log} 2>&1 < /dev/null\n"
        "pre_rc=$?\n"
        "pre_d=$(( $(date +%s) - pre_t0 ))\n"
        f'echo "$pre_rc" > {str(d / "pre_exit_code")!r}\n'
        'echo "pre-step: exit $pre_rc after '
        '$(printf "%dm%02ds" $((pre_d/60)) $((pre_d%60)))" '
        f">> {log}\n"
        f'if {{ [ "$pre_rc" -eq 124 ] || [ "$pre_rc" -eq 137 ]; }} '
        f'&& [ "$pre_d" -ge {secs} ]; then\n'
        f'  echo {secs} > {str(d / "pre_timed_out")!r}\n'
        f'  echo "pre-step: killed by the {secs}s hang guard" >> {log}\n'
        "  rc=124\n"
        "else\n"
    )


def job_tmpdir_lines(d: Path) -> tuple[str, str]:
    """run.sh head and tail that give a job its own TMPDIR (dv-1a02).

    /tmp is tmpfs (RAM, user quota): scratch a job leaves there (test DBs,
    copied venvs) used to pile up until the CLI hit EDQUOT. Under the job dir
    it is on disk and the tail removes it. CLAUDE_CODE_TMPDIR keeps the CLI's
    scratch and bash_box.scratch_dir() (from gettempdir()) on the same path.
    The tail is the last line, after the ping, so a summary image is still
    there when it is sent; a killed unit leaves it on disk, not in RAM."""
    tmp = shlex.quote(str(d / "tmp"))
    export = f"export TMPDIR={tmp} CLAUDE_CODE_TMPDIR={tmp}\n"
    head = export + 'mkdir -m 700 -p "$TMPDIR"\n'
    return head, f"rm -rf {tmp}\n"


def cgroup_carveout(agent_max: str, log: Path) -> str:
    """run.sh lines that split an agent job's delegated cgroup (Delegate=yes)
    into box/agent (this shell and everything it starts, capped at the job's
    own cap) and room for scripts/testrun's box/testrun-* leaves. Only box/ is
    bound rw into the box, so the unit's own memory.max stays out of reach.

    cgroup v2 forbids processes in a cgroup that hands out controllers: the
    shell moves into the leaf before +memory is written. Without delegation
    box_cg stays empty and testrun falls back to RLIMIT_AS inside the unit cap."""
    limit = _size_bytes(agent_max)
    write_max = (
        f'  echo {limit} > "$cg/box/agent/memory.max"\n' if limit is not None else ""
    )
    return (
        "box_cg=''\n"
        'cg="/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)"\n'
        'if mkdir -p "$cg/box/agent" 2>/dev/null \\\n'
        '   && echo $$ > "$cg/box/agent/cgroup.procs" \\\n'
        '   && echo +memory > "$cg/cgroup.subtree_control" \\\n'
        '   && echo +memory > "$cg/box/cgroup.subtree_control"; then\n'
        f"{write_max}"
        '  box_cg="--bind $cg/box $cg/box"\n'
        "else\n"
        '  echo "bgjob: no cgroup delegation; tests share the job cap" '
        f">> {str(log)!r}\n"
        "fi 2>/dev/null\n"
    )


_REGISTRY_DUMP = """
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from src.config.loader import load_config
from src.profiles import load_profile_registry
# No loadable settings (a checkout without them: tests, CI) = the safe
# defaults: sandboxed, the registry's own data root.
try:
    config = load_config(config_file=Path(sys.argv[1]) / '.env')
    sandbox_default = config.sandbox_enabled
    kw = {"data_root": config.devvy_data_root}
except Exception:
    sandbox_default, kw = True, {}
reg = load_profile_registry(Path(sys.argv[2]), sandbox_default=sandbox_default, **kw)
print(json.dumps({
    p.slug: {"working_dir": str(p.working_dir),
             "extra_dirs": [str(d) for d in p.extra_dirs],
             "sandbox": p.sandbox if p.sandbox is not None else sandbox_default,
             "unrestricted": p.unrestricted}
    for p in reg.profiles
}))
"""


def _registry() -> dict:
    """slug -> {working_dir, extra_dirs}, resolved by the bot's own registry
    loader (${DEVVY_WORKSPACES}, relative dirs, data root). A private YAML
    parser here used to miss variable expansion, so jobs for template-created
    profiles failed with "working dir does not exist: ${DEVVY_WORKSPACES}/..".
    """
    if not PROFILES_YAML.exists():
        return {}
    proc = subprocess.run(
        [_venv_python(), "-c", _REGISTRY_DUMP, str(REPO), str(PROFILES_YAML)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        err = (proc.stderr.strip().splitlines() or ["?"])[-1]
        sys.exit(f"error: cannot load profiles registry: {err}")
    # The loader logs to stdout too; the JSON is always the last line.
    return json.loads((proc.stdout.strip().splitlines() or ["{}"])[-1])


def load_profiles() -> dict:
    """slug -> working_dir."""
    return {s: p["working_dir"] for s, p in _registry().items()}


def load_extra_dirs(slug: str) -> list:
    """The profile's ``extra_dirs`` (owner-only, dv-3103). A job runs with the
    owner's authority, so it may write where the profile's turns may."""
    return list(_registry().get(slug, {}).get("extra_dirs", []))


def confined_codex_profile(slug: str) -> bool:
    """Only a sandboxed, restricted profile may use native Codex isolation."""
    profile = _registry().get(slug, {})
    return profile.get("sandbox", True) is True and not profile.get("unrestricted")


def extract_summary(text: str) -> str:
    """The job's `<summary>` block (the LAST one, so quoted examples earlier in
    the answer lose), else the last SUMMARY_LINES lines. Always capped, so a
    crashed job or one that ignored the contract still yields a summary."""
    found = _SUMMARY_RE.findall(text)
    if found:
        body = found[-1].strip().splitlines()
        # `image:` lines are delivery instructions (dv-f90c: notify reads them
        # from summary.md), not prose: exempt them from the cap, else a long
        # summary silently drops the screenshots it lists at the end.
        images = [ln for ln in body if ln.lower().startswith("image:")][:10]
        text = [ln for ln in body if not ln.lower().startswith("image:")]
        out = "\n".join(text[:SUMMARY_LINES])[:SUMMARY_CHARS]
        return "\n".join([out, *images]) if images else out
    lines = text.strip().splitlines()[-SUMMARY_LINES:]
    if not lines:
        return ""
    return ("(no summary block; tail)\n" + "\n".join(lines))[:SUMMARY_CHARS]


CMD_SUMMARY_LINES = 30
_PYTEST_RE = re.compile(r"\d+ (passed|failed|error|skipped|deselected)")


def cmd_oneline_text(text: str) -> str:
    """One-line result of a plain-command job: pytest's passed/failed line when
    there is one, else the last non-empty line."""
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    for ln in reversed(lines):
        if _PYTEST_RE.search(ln):
            return ln.strip("= ").strip()[:200]
    return (lines[-1] if lines else "(no output)")[:200]


def write_cmd_summary(job_id: str) -> str:
    """summary.md of a --cmd job: exit code + the last ~30 output lines."""
    d = job_dir(job_id)
    try:
        text = (d / "output.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    try:
        rc = (d / "exit_code").read_text().strip()
    except OSError:
        rc = "?"
    # Verdict first: readers (Jobs ping, reply context) show only the head, and
    # a long warnings tail used to push pytest's result line out of view.
    head = f"exit code: {rc} | {cmd_oneline_text(text)}\n"
    tail = "\n".join(text.strip().splitlines()[-CMD_SUMMARY_LINES:])
    tail = tail[-(SUMMARY_CHARS * 2 - len(head)) :]
    summary = head + tail
    (d / "summary.md").write_text(summary + "\n", encoding="utf-8")
    return summary


def write_summary(job_id: str) -> str:
    d = job_dir(job_id)
    if read_meta(job_id).get("cmd"):
        return write_cmd_summary(job_id)
    try:
        text = (d / "output.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    summary = extract_summary(text)
    if not summary:
        err = ""
        try:
            lines = (d / "stderr.log").read_text(errors="replace").strip().splitlines()
            preflight = [line for line in lines if "agentjob preflight failed:" in line]
            err = preflight[-1] if preflight else "\n".join(lines[-3:])
        except OSError:
            pass
        summary = "(no output)" + (f"\n{err}" if err else "")
    (d / "summary.md").write_text(summary + "\n", encoding="utf-8")
    return summary


def job_dir(job_id: str) -> Path:
    return JOBS_ROOT / job_id


def read_meta(job_id: str) -> dict:
    try:
        return json.loads((job_dir(job_id) / "meta.json").read_text())
    except Exception:
        return {}


def job_active(jid: str, meta: dict) -> bool:
    """Is this job still running, asked of the launcher that started it."""
    if launcher.is_process(meta):
        return launcher.active(job_dir(jid))
    return bool(meta.get("unit")) and unit_active(meta["unit"])


def unit_active(unit: str) -> bool:
    r = subprocess.run(
        ["systemctl", "--user", "is-active", unit],
        capture_output=True,
        text=True,
        env=_env(),
    )
    return r.stdout.strip() in {"active", "activating"}


def all_jobs() -> list:
    if not JOBS_ROOT.exists():
        return []
    # Only dirs bgjob created (meta.json); other tools' scratch dirs that land
    # here (release_public --out) otherwise list as "failed(rc=?) 0B".
    return sorted(
        (p.name for p in JOBS_ROOT.iterdir() if (p / "meta.json").is_file()),
        reverse=True,
    )


def job_progress(unit: str) -> str:
    """Human-readable proof a running job is actually doing work.

    output.md is useless as a progress signal (claude buffers it to the end),
    so read CPU time and memory straight from the job's cgroup: a job burning
    CPU is working, a job at 0s CPU for minutes is stuck.
    """
    base = (
        Path("/sys/fs/cgroup/user.slice")
        / f"user-{os.getuid()}.slice"
        / f"user@{os.getuid()}.service"
        / "app.slice"
        / f"{unit}.service"
    )
    try:
        cpu_us = 0
        for line in (base / "cpu.stat").read_text().splitlines():
            if line.startswith("usage_usec"):
                cpu_us = int(line.split()[1])
                break
        mem = int((base / "memory.current").read_text().strip())
        return f"cpu {cpu_us // 1_000_000}s, mem {mem // 1048576}MB"
    except Exception:
        return ""


def job_elapsed(jid: str) -> str:
    """Wall-clock age of a job, derived from its timestamped id.

    The id prefix is the only start timestamp that exists for every job
    regardless of how it was launched, so no meta.json change is needed.
    """
    try:
        started = datetime.strptime(jid[:15], "%Y%m%d-%H%M%S").replace(tzinfo=UTC)
    except (ValueError, IndexError):
        return ""
    secs = int((datetime.now(UTC) - started).total_seconds())
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    return f"{secs // 3600}h{(secs % 3600) // 60:02d}m"


def live_jobs() -> list:
    """Jobs holding a slot: unit active and not QUEUED (waiting for one)."""
    out = []
    for jid in all_jobs():
        if (job_dir(jid) / "QUEUED").exists():
            continue
        if job_active(jid, read_meta(jid)):
            out.append(jid)
    return out


# A --queue job waits this long for a slot, then gives up with SLOT_TIMEOUT_RC
# (EX_TEMPFAIL) instead of waiting forever behind a stuck job (dv-5432).
SLOT_WAIT_MAX_S = 2 * 3600
SLOT_POLL_S = 30
SLOT_TIMEOUT_RC = 75


def cmd_wait_slot(args: argparse.Namespace) -> int:
    """Block a queued job until a slot is free, then take it (drop QUEUED).

    Runs first in a --queue job's run.sh. The check-and-take is under one
    flock, so two waiters never both pass on the same free slot; the lock is
    not held while sleeping, so a queued job never blocks the others' check.
    """
    import fcntl

    marker = job_dir(args.id) / "QUEUED"
    deadline = time.monotonic() + SLOT_WAIT_MAX_S
    JOBS_ROOT.mkdir(parents=True, exist_ok=True)
    while True:
        with open(JOBS_ROOT / ".slot.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            holders = [j for j in live_jobs() if j != args.id]
            if len(holders) < MAX_CONCURRENT:
                marker.unlink(missing_ok=True)
                return 0
        if time.monotonic() >= deadline:
            print(
                f"no job slot in {SLOT_WAIT_MAX_S // 3600}h (cap {MAX_CONCURRENT})",
                file=sys.stderr,
            )
            return SLOT_TIMEOUT_RC
        time.sleep(SLOT_POLL_S)


def _venv_python() -> str:
    """The bot's poetry venv python, resolved here (outside the sandbox) so the
    job does not have to find poetry itself."""
    try:
        import claude_agent_sdk  # noqa: F401

        return sys.executable
    except ImportError:
        pass
    poetry = shutil.which("poetry") or str(Path.home() / ".local/bin/poetry")
    try:
        venv = subprocess.run(
            [poetry, "env", "info", "-p"],
            cwd=str(REPO),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        sys.exit(f"error: cannot locate the bot's poetry venv ({exc})")
    python = Path(venv) / "bin" / "python"
    if not python.exists():
        sys.exit(f"error: venv python not found at {python}")
    return str(python)


DUP_WINDOW_S = 30 * 60


def find_duplicate(name: str, task: str | None, now: float | None = None) -> str:
    """Why a new prompt job duplicates a recent one ("" = it does not).

    Same name or same ticket as a job that is RUNNING or finished OK within
    DUP_WINDOW_S. A failed job does not count (re-running it is the fix), and
    neither do plain --cmd jobs (e.g. full-tests are rerun on purpose).
    """
    now = time.time() if now is None else now
    for jid in all_jobs():
        meta = read_meta(jid)
        if meta.get("cmd"):
            continue
        same_name = meta.get("name") == name
        same_task = bool(task) and meta.get("task") == task
        if not (same_name or same_task):
            continue
        what = "same name" if same_name else f"same task {task}"
        ec = job_dir(jid) / "exit_code"
        if not ec.exists():
            if unit_active(meta.get("unit", "")):
                return f"job {jid} is RUNNING ({what})"
            continue
        if ec.read_text().strip() != "0":
            continue
        age = now - ec.stat().st_mtime
        if age < DUP_WINDOW_S:
            return f"job {jid} finished {int(age // 60)} min ago ({what})"
    return ""


BATCH_CAP_S = 30 * 60
BATCH_POLL_S = 30
BATCH_WATCH_MAX_S = 3 * 3600


def batch_dir() -> Path:
    return JOBS_ROOT / ".batches"


def batch_jobs(batch: str) -> list:
    """Ids of the digestable jobs in a batch (a job with no batch is its own)."""
    out = []
    for jid in all_jobs():
        meta = read_meta(jid)
        if meta.get("cmd") or meta.get("quiet"):
            continue
        if meta.get("batch", jid) == batch:
            out.append(jid)
    return sorted(out)


def plan_digest(
    finished: list, running: list, sent: list, first_finished: float | None, now: float
) -> tuple:
    """What to do for one batch: ("none",) | ("wait",) | ("send", ids, running).

    A digest goes out when nothing in the batch is running any more, or when
    BATCH_CAP_S passed since the first not-yet-reported job finished (then it
    names the jobs still running; those get their own digest when they end).
    """
    unsent = [j for j in finished if j not in set(sent)]
    if not unsent:
        return ("none",)
    if not running:
        return ("send", unsent, [])
    if first_finished is not None and now - first_finished >= BATCH_CAP_S:
        return ("send", unsent, list(running))
    return ("wait",)


def _job_rc(jid: str) -> str:
    ec = job_dir(jid) / "exit_code"
    try:
        return ec.read_text().strip() or "?"
    except OSError:
        return "?"


def build_digest_prompt(unsent: list, running: list) -> str:
    """The one turn that reports a batch to the owner, in the agent's own chat."""
    lines = []
    for jid in unsent:
        name = read_meta(jid).get("name") or jid
        rc = _job_rc(jid)
        state = (
            "finished OK"
            if rc == "0"
            else (
                "INCOMPLETE (background work killed, exit code 3)"
                if rc == "3"
                else f"FAILED (exit code {rc})"
            )
        )
        lines.append(
            f'- "{name}" (id {jid}): {state}; summary {job_dir(jid) / "summary.md"}'
        )
    many = len(unsent) > 1
    text = (
        "[Background jobs you started have finished:\n"
        + "\n".join(lines)
        + "\nRead each summary (job_output tool returns it); the full output "
        "only if the summary is not enough. Report to the user in ONE message"
        + (" covering all of them" if many else "")
        + ": the result, any problems, and every question for the user, so "
        "they can answer in a single reply. The user already sees each job's "
        "short summary in Jobs and may already have commented on these jobs "
        "there; those replies are earlier in this conversation. Take what "
        "they said into account and do NOT ask again what they already "
        "answered. Not a re-dump of the summaries."
    )
    if running:
        names = ", ".join(f'"{read_meta(j).get("name") or j}" ({j})' for j in running)
        text += (
            f" Still running, each gets its own digest when it ends: {names}; "
            "say so in your message."
        )
    return text + "]"


def _agentctl_prompt(
    profile: str,
    text: str,
    name: str,
    user_id: int = 0,
    chat_id: int = 0,
    cwd: str = "",
) -> bool:
    argv = [str(AGENTCTL), "prompt", text, "--profile", profile, "--name", name]
    if user_id:
        argv += ["--user-id", str(user_id)]
    if chat_id:
        argv += ["--chat-id", str(chat_id)]
    if cwd:
        argv += ["--cwd", cwd]
    r = subprocess.run(
        argv,
        capture_output=True,
        text=True,
    )
    return r.returncode == 0


def _notification_chat_id(args: argparse.Namespace) -> int | None:
    return getattr(args, "chat_id", None) or getattr(args, "user_id", None)


def _notify_chat_flag(args: argparse.Namespace) -> str:
    chat_id = _notification_chat_id(args)
    return f"--chat-id {int(chat_id)} " if chat_id else ""


def _spawn_watcher(batch: str) -> None:
    """A separate transient unit (not a job: it is not listed or counted) that
    re-checks the batch until its digest is out. A Popen from run.sh would be
    killed with that job's cgroup."""
    unit = f"bgbatch-{batch}"
    if launcher.kind() == launcher.PROCESS:
        # No user manager: a new session outlives run.sh just the same. A
        # second watcher is harmless (digest_batch is serialized by flock).
        launcher.spawn_detached(
            [sys.executable, str(Path(__file__).resolve()), "digest-watch", batch]
        )
        return
    if unit_active(unit):
        return
    subprocess.run(
        [
            "systemd-run",
            "--user",
            "--quiet",
            f"--unit={unit}",
            "--collect",
            sys.executable,
            str(Path(__file__).resolve()),
            "digest-watch",
            batch,
        ],
        capture_output=True,
        text=True,
        env=_env(),
    )


def _digest_cwd(meta: dict) -> str:
    """The job's cwd when the digest turn may run there: the profile root or
    the launching owner's own workspace (what /internal/prompt accepts).
    Anything else (a /repo project dir) gives "" -- the API then starts at the
    profile root and wraps it into that owner's workspace, so the digest is
    still delivered instead of failing with "invalid job workspace"."""
    cwd, root = meta.get("cwd"), meta.get("profile_root")
    if not cwd or not root:
        return ""
    resolved, base = Path(cwd).resolve(), Path(root).resolve()
    if resolved not in (base, base / "users" / str(meta["user_id"])):
        return ""
    return str(cwd)


def digest_batch(batch: str, now: float | None = None, spawn: bool = True) -> str:
    """One check of a batch; sends its digest when due. Returns what happened:
    "sent" | "none" | "wait" | "failed". Serialized per batch (flock), so the
    finishing jobs and the watcher never send twice."""
    import fcntl

    now = time.time() if now is None else now
    bd = batch_dir()
    bd.mkdir(parents=True, exist_ok=True)
    with open(bd / f"{batch}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        sp = bd / f"{batch}.json"
        try:
            state = json.loads(sp.read_text())
        except (OSError, ValueError):
            state = {}
        jobs = batch_jobs(batch)
        finished, running = [], []
        for jid in jobs:
            if (job_dir(jid) / "exit_code").exists():
                finished.append(jid)
            elif unit_active(read_meta(jid).get("unit", "")):
                running.append(jid)
            else:
                finished.append(jid)  # died without an exit code: report it
        sent = list(state.get("sent", []))
        first = state.get("first_finished")
        if first is None and [j for j in finished if j not in sent]:
            first = now
        plan = plan_digest(finished, running, sent, first, now)
        if plan[0] == "send":
            meta = read_meta(plan[1][0])
            profile = meta.get("profile") or ""
            text = build_digest_prompt(plan[1], plan[2])
            audience = {}
            if meta.get("user_id"):
                audience = {
                    "user_id": int(meta["user_id"]),
                    "chat_id": int(meta.get("chat_id") or meta["user_id"]),
                }
                cwd = _digest_cwd(meta)
                if cwd:
                    audience["cwd"] = cwd
            if not profile or not _agentctl_prompt(
                profile, text, f"job-finish:{batch}", **audience
            ):
                result = "failed"
            else:
                sent += plan[1]
                first = None
                result = "sent"
        else:
            result = plan[0]
        sp.write_text(json.dumps({"sent": sent, "first_finished": first}))
    if result == "wait" and spawn:
        _spawn_watcher(batch)
    return result


def cmd_digest(args: argparse.Namespace) -> int:
    """Called by a finishing job's run.sh: digest its batch if it is complete."""
    batch = read_meta(args.id).get("batch", args.id)
    print(digest_batch(batch))
    return 0


def cmd_digest_watch(args: argparse.Namespace) -> int:
    """Poll one batch until its digest is out (bounded; see BATCH_WATCH_MAX_S)."""
    deadline = time.time() + BATCH_WATCH_MAX_S
    while time.time() < deadline:
        if digest_batch(args.batch, spawn=False) in ("sent", "none"):
            return 0
        time.sleep(BATCH_POLL_S)
    return 1


def job_harness(python_bin: str, agentjob: Path, args: argparse.Namespace) -> str:
    """The harness the job's route resolves to (`agentjob --print-route`,
    dv-d63d), so the box can be built for it. An empty result stops launch."""
    cmd = [python_bin, str(agentjob), "--print-route"]
    if getattr(args, "route", None):
        cmd += ["--route", args.route]
    if getattr(args, "model", None):
        cmd += ["--model", args.model]
    if getattr(args, "harness", None):
        cmd += ["--harness", args.harness]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        route = json.loads(r.stdout or "{}") if r.returncode == 0 else {}
    except (OSError, subprocess.SubprocessError, ValueError):
        route = {}
    if not isinstance(route, dict) or not route.get("harness"):
        return ""
    return str(route["harness"])


def cmd_run(args: argparse.Namespace) -> int:
    profiles = load_profiles()
    cwd = profiles.get(args.profile)
    profile_root = cwd
    if not cwd:
        sys.exit(
            f"error: unknown profile '{args.profile}'. "
            f"Known: {', '.join(sorted(profiles)) or '(none)'}"
        )
    if not Path(cwd).is_dir():
        sys.exit(f"error: working dir does not exist: {cwd}")

    # --cwd overrides where the job runs AND what it may write; the profile is
    # still resolved above because the digest turn has to be delivered into
    # some profile's conversation.
    if getattr(args, "cwd", None):
        override = Path(args.cwd).expanduser().resolve()
        if not override.is_dir():
            sys.exit(f"error: --cwd does not exist: {override}")
        cwd = str(override)

    command = getattr(args, "cmd", None)
    queue = getattr(args, "queue", False)
    if queue and not command:
        # A model turn that starts an hour late is usually stale: prompt jobs
        # are refused at the cap, never queued (dv-5432).
        sys.exit("error: --queue is for --cmd jobs only")
    running = live_jobs()
    queued = queue and len(running) >= MAX_CONCURRENT
    if len(running) >= MAX_CONCURRENT and not queued:
        sys.exit(
            f"error: {len(running)} job(s) already running "
            f"(cap {MAX_CONCURRENT}, set by BGJOB_MAX_CONCURRENT). "
            f"Wait or `bgjob cancel {running[0]}`."
        )

    quiet = getattr(args, "quiet", False)
    if command and (args.prompt or getattr(args, "task", None)):
        sys.exit("error: --cmd takes no prompt and no --task")
    if not command and not args.prompt:
        sys.exit("error: a prompt (or --cmd) is required")
    pre_cmd = getattr(args, "pre_cmd", None)
    if pre_cmd and command:
        # A --cmd job IS a command; the step exists to run one before a turn.
        sys.exit("error: --pre-cmd is for model-turn jobs only, not --cmd")
    if getattr(args, "harness", None) and command:
        # dv-a8e4: the override picks the model harness; a --cmd job has none.
        sys.exit("error: --harness is for model-turn jobs only, not --cmd")
    if pre_cmd and not getattr(args, "pre_log", None):
        sys.exit("error: --pre-cmd needs --pre-log")
    task = getattr(args, "task", None)
    ticket = ""
    if task:
        # The home board's card file: <repo>/.deviz/tasks/<id>.md.
        board, _, bare = task.rpartition(":")
        card = HOME_TASKS / f"{bare}.md"
        found = board in ("", "devvy") and card.is_file()
        ticket = str(card.resolve()) if found else ""
        if not ticket:
            sys.exit(
                f"error: unknown task {task}: task_id only knows this repo's "
                f"(devvy) board, not other agents' boards. For any other "
                f"ticket, name it in the prompt and omit task_id."
            )
    if not command and not getattr(args, "force", False):
        refuse_on_limit(args)
    if not quiet and not command and not getattr(args, "force", False):
        dup = find_duplicate(args.name, task)
        if dup:
            sys.exit(
                f"error: duplicate job refused: {dup}. Same name or task within "
                f"{DUP_WINDOW_S // 60} min is blocked; if a re-run is intended "
                f"pass --force (job_start force=true)."
            )
    if not quiet and not command:
        parts = []
        try:
            parts.append(PREAMBLE.read_text(encoding="utf-8").strip())
        except OSError:
            pass  # a missing preamble must not stop a job
        if ticket:
            parts.append(f"Ticket: {ticket} — read it first, it is the spec.")
        parts.append(args.prompt)
        args.prompt = "\n\n".join(parts)

    stamp = datetime.now(UTC).strftime("%Y%m%d-%H%M%S")
    safe = re.sub(r"[^a-zA-Z0-9_-]+", "-", args.name).strip("-") or "job"
    job_id = f"{stamp}-{safe}"
    d = job_dir(job_id)
    d.mkdir(parents=True, exist_ok=True)

    if command:
        args.prompt = command
        (d / "cmd.txt").write_text(command, encoding="utf-8")
    (d / "prompt.txt").write_text(args.prompt, encoding="utf-8")
    output = d / "output.md"
    output.touch()

    unit = f"bgjob-{job_id}"
    how = launcher.kind()
    meta = {
        "id": job_id,
        "name": args.name,
        "profile": args.profile,
        "cwd": cwd,
        "profile_root": profile_root,
        "user_id": getattr(args, "user_id", None),
        "chat_id": getattr(args, "chat_id", None),
        "unit": unit,
        "created": datetime.now(UTC).isoformat(),
        "model": args.model,
        "route": getattr(args, "route", None),
        "harness": getattr(args, "harness", None),
        "prompt": args.prompt[:2000],
    }
    if how == launcher.PROCESS:
        meta["launcher"] = how
    if command:
        meta["cmd"] = command[:2000]
    if pre_cmd:
        (d / "pre_cmd.txt").write_text(pre_cmd, encoding="utf-8")
        meta["pre"] = {
            "cmd": pre_cmd[:2000],
            "log": str(args.pre_log),
            "timeout": int(getattr(args, "pre_timeout", None) or PRE_TIMEOUT_S),
        }
    if queued:
        meta["queued"] = True
        # Written before the unit starts so live_jobs() never counts it;
        # `wait-slot` removes it when the job takes a slot.
        (d / "QUEUED").write_text("", encoding="utf-8")
    if task:
        meta["task"] = task
    if quiet:
        meta["quiet"] = True
    if not command and not quiet:
        # Jobs started in one agent turn share a batch (job_start passes the
        # turn id); any other launch is a batch of one.
        meta["batch"] = getattr(args, "batch", None) or job_id
    (d / "meta.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")

    if command:
        return _launch_cmd_job(args, job_id, d, cwd, unit, output, quiet, queued)

    # The turn runs through the model router (scripts/agentjob, dv-ef90): same
    # tool-call policy as chat, asks go to the owner over the bot, and the call
    # is recorded. systemd --user units get a minimal PATH, so the wrapper
    # names the script and its python by absolute path.
    agentjob = REPO / "scripts" / "agentjob"
    python_bin = _venv_python()

    # The outer box confines Claude and Codex pre-steps; confined Codex tool
    # calls use its native permission profile after a host-side preflight.
    # systemd provides the unit memory cap, not filesystem confinement.
    # systemd --user accepts ProtectSystem=strict / ReadWritePaths / ProtectHome
    # and reports Result=success, but silently does not enforce them (the user
    # manager lacks the privileges for the mount namespace) -- verified: a job
    # with those properties still wrote outside its workspace. bwrap does
    # enforce: everything is read-only except the paths bound rw below.
    # No bwrap (macOS): sandbox-exec with the Seatbelt job profile; neither
    # tool = refuse (job_box).
    write_paths = [str(d), cwd, str(Path.home() / ".claude")]
    # dv-d63d: a Codex job writes its sessions/rollouts and refreshes its
    # login under ~/.codex; a Claude job keeps today's write set.
    harness = job_harness(python_bin, agentjob, args)
    if not harness:
        sys.exit("error: job route probe failed; no model job launched")
    native_codex = harness == "openai_codex" and confined_codex_profile(args.profile)
    if harness == "openai_codex":
        write_paths.append(str(Path.home() / ".codex"))
    allow_dirs = list(args.allow_dir or [])
    if cwd_in_profile(Path(cwd), Path(profiles[args.profile])):
        # Profile roots and owner workspaces keep their configured write dirs.
        allow_dirs += load_extra_dirs(args.profile)
    effective_dirs = []
    for extra in allow_dirs:
        p = Path(extra).expanduser().resolve()
        if not p.is_dir() or p == Path("/"):
            sys.exit(f"error: invalid --allow-dir: {p}")
        write_paths.append(str(p))
        effective_dirs.append(str(p))

    bwrap_prefix = job_box(d, write_paths)
    agent_prefix = "" if native_codex else bwrap_prefix + " "
    native_flag = "--native-preflight " if native_codex else ""
    extra_flags = "".join(
        f"--allow-dir {shlex.quote(path)} " for path in dict.fromkeys(effective_dirs)
    )
    # Only an explicit --setting-sources reaches agentjob (pump2: project);
    # without it agentjob keeps its own default, user + project (dv-fe02).
    setting_sources = getattr(args, "setting_sources", None)
    sources_flag = (
        f"--setting-sources {shlex.quote(setting_sources)} " if setting_sources else ""
    )

    # Everything after the claude call is reporting, and --quiet drops all of
    # it: pump2-launched jobs write a structured report their caller renders
    # into one short message, and the raw-tail ping would be a second, worse
    # copy of the same news.
    notify_chat_flag = _notify_chat_flag(args)
    notify_tail = (
        # A usage limit: one notice in the agent's own chat too (dv-47f9).
        f"if [ $rc -eq 4 ]; then {shlex.quote(python_bin)} "
        f"{str(Path(__file__).resolve())!r} limit-notice {shlex.quote(job_id)} "
        ">/dev/null 2>&1 || true; fi\n"
        "d=$(( $(date +%s) - t0 ))\n"
        'dur=$(printf "%dm%02ds" $((d/60)) $((d%60)))\n'
        'if [ $rc -eq 0 ]; then icon="✅"; s="finished"; '
        # agentjob exit 3 (dv-b6dd): the answer came, but work the job had
        # started in the background was still running and was killed.
        'elif [ $rc -eq 3 ]; then icon="⚠️"; '
        's="INCOMPLETE (background work was still running and was killed)"; '
        # agentjob exit 4 (dv-7ad9): the usage limit ran out. Not a failure of
        # the work; the reset comes from agentjob's quota line.
        f"elif [ $rc -eq 4 ]; then icon=\"⏸\"; "
        "until_iso=$(sed -n 's/^agentjob quota: .* until \\([^ ]*\\).*$/\\1/p' "
        f"{str(d / 'stderr.log')!r} 2>/dev/null | tail -n 1); "
        'at=$(date -u -d "$until_iso" "+%H:%M UTC" 2>/dev/null || echo "?"); '
        's="stopped on usage limit (resets $at)"; '
        'else icon="❌"; s="FAILED (rc=$rc)"; fi\n'
        f'msg="$icon {args.profile} · job \\"{args.name}\\" $s\n'
        f"started $started_h · ran $dur\n"
        f"id: {job_id}\n"
        f'output: {str(output)}"\n'
        # A job that dies half-way through a merge or rebase leaves its tree
        # that way (26.10: a merge job stopped on the limit left MERGE_HEAD in
        # the live checkout). Only a warning: nothing aborts it by hand.
        f"jcwd={shlex.quote(cwd)}\n"
        "if [ $rc -ne 0 ]; then\n"
        "  for g in MERGE_HEAD:merge rebase-merge:rebase rebase-apply:rebase; do\n"
        '    gp=$(git -C "$jcwd" rev-parse --path-format=absolute '
        '--git-path "${g%%:*}" 2>/dev/null)\n'
        '    if [ -n "$gp" ] && [ -e "$gp" ]; then\n'
        '      msg="$msg\n⚠ $jcwd is mid-${g#*:} — resolve by hand"; break\n'
        "    fi\n"
        "  done\n"
        "fi\n"
        # The ping must carry the ANSWER, not just say "there is a file". Tail
        # capped so _split_message doesn't chunk the notification; the header
        # above already names the full output path for the truncated case.
        f'hdr="$msg"\n'
        f"out_bytes=$(wc -c < {str(output)!r} 2>/dev/null || echo 0)\n"
        f'if [ "$out_bytes" -gt 0 ]; then\n'
        # `tail -c` is a byte cut and can start mid-character; iconv -c drops
        # the partial bytes so the notifier never sees invalid UTF-8 (dv-c9d1).
        f"  body=$(tail -c 1500 {str(output)!r} | iconv -f utf-8 -t utf-8 -c)\n"
        f'  if [ "$out_bytes" -gt 1500 ]; then body="…$body"; fi\n'
        f'  msg="$msg\n'
        f"\n"
        f'$body"\n'
        f"fi\n"
        # summary.md (written by run.sh) beats the raw tail: the verdict is
        # usually last, but a tail cuts mid-sentence. Tail stays the fallback.
        f"if [ -s {str(d / 'summary.md')!r} ]; then\n"
        f'  msg="$hdr\n\n$(cat {str(d / "summary.md")!r})"\n'
        f"fi\n"
        # The bot may be down exactly when we finish -- a restart is the whole
        # reason this runner exists. A single fire-and-forget notify would be
        # swallowed by `|| true` and the user would never learn the job ended.
        # Retry for ~5 min, then leave a PENDING_NOTIFY marker so the result is
        # still discoverable instead of silently lost.
        f"sent=0\n"
        f"for i in $(seq 1 30); do\n"
        f'  if {str(AGENTCTL)!r} notify --source bgjob --markdown --ref job:{job_id} --profile {args.profile} {notify_chat_flag}--images-from {str(d / "summary.md")!r} "$msg" >>{str(d / "notify.log")!r} 2>&1; then\n'
        f"    sent=1; break\n"
        f"  fi\n"
        f"  sleep 10\n"
        f"done\n"
        f'if [ "$sent" != "1" ]; then echo "$msg" > {str(d / "PENDING_NOTIFY")!r}; fi\n'
        # Batch digest: the ✅ ping above is the whole Jobs-side report. The
        # agent's own chat gets ONE digest turn per batch, sent by whichever
        # finishing job (or the batch watcher) sees the batch complete.
        f'if [ "$sent" = "1" ]; then\n'
        f"  {shlex.quote(python_bin)} {str(Path(__file__).resolve())!r} "
        f"digest {shlex.quote(job_id)} "
        f">>{str(d / 'notify.log')!r} 2>&1 || true\n"
        f"fi\n"
        # Retire/refresh the pinned status: this job is no longer running, and
        # a pin still listing it is worse than no pin. --exclude because this
        # very unit is still `active` while run.sh executes this line, so an
        # unfiltered render would list the finished job as running forever.
        f'{str(REPO / "scripts" / "bgjob")!r} pin --exclude {job_id} '
        f">/dev/null 2>&1 || true\n"
    )
    if getattr(args, "quiet", False):
        notify_tail = ""

    # dv-d63d: the job route names the models.yaml `jobs:` row agentjob runs
    # on; no --model unless the caller gave one (it would beat the row).
    route = getattr(args, "route", None)
    # dv-a8e4: an explicit --harness is repeated, never added by bgjob.
    harness_flag = getattr(args, "harness", None)
    route_flags = (
        (f"--route {shlex.quote(route)} " if route else "")
        + (f"--model {shlex.quote(args.model)} " if args.model else "")
        + (f"--harness {shlex.quote(harness_flag)} " if harness_flag else "")
    )

    # dv-781f: the task context for the ask explainer, verbatim from pump2.
    ask_context = getattr(args, "ask_context", None)
    ask_flag = f"--ask-context {shlex.quote(ask_context)} " if ask_context else ""

    pre_step = pre_step_lines(d, bwrap_prefix, meta["pre"]) if pre_cmd else ""
    # The wrapper keeps claude's stdout streaming into output.md so partial
    # work survives a crash, records the exit code, then pings Telegram.
    tmp_head, tmp_tail = job_tmpdir_lines(d)
    runner = d / "run.sh"
    runner.write_text(
        "#!/bin/bash\n"
        # Transient systemd units inherit the user manager's minimal PATH,
        # not the caller's. Codex is installed in ~/.npm-global/bin here.
        'export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:$PATH"\n'
        # Timestamps captured here, not at completion: the finish notification
        # has to say when the job STARTED and how long it ran, otherwise the
        # user cannot tell which request it belongs to.
        "t0=$(date +%s)\n"
        "started_h=$(date -u '+%H:%M UTC')\n"
        f"cd {cwd!r} || exit 1\n"
        + tmp_head
        + (
            # No unit, no delegated cgroup: the supervisor's soft cap holds.
            "box_cg=''\n"
            if how == launcher.PROCESS
            else cgroup_carveout(JOB_MEMORY_MAX, d / "stderr.log")
        )
        + pre_step
        + f"{agent_prefix}{shlex.quote(python_bin)} {str(agentjob)!r} "
        f"--profile {shlex.quote(args.profile)} --cwd {cwd!r} "
        f"{native_flag}{extra_flags}"
        f"--prompt-file {str(d / 'prompt.txt')!r} "
        f"{route_flags}--name {shlex.quote(args.name)} "
        f"{sources_flag}"
        f"{ask_flag}"
        f"--session-file {str(d / 'session_id')!r} "
        f"{'--ignore-quota ' if getattr(args, 'force', False) else ''}"
        # stdout is the answer; the runner's log lines go to their own file.
        f">> {str(output)!r} 2>> {str(d / 'stderr.log')!r}\n"
        "rc=$?\n"
        + f"if [ $rc -ne 0 ] && [ ! -s {str(output)!r} ]; then\n"
        + f"  tail -n 8 {str(d / 'stderr.log')!r} > {str(d / 'summary.md')!r}\n"
        + "fi\n"
        + ("fi\n" if pre_cmd else "")
        + f'echo "$rc" > {str(d / "exit_code")!r}\n'
        f"{shlex.quote(python_bin)} {str(Path(__file__).resolve())!r} "
        f"summarize {shlex.quote(job_id)} >/dev/null 2>&1 || true\n"
        + notify_tail
        + tmp_tail,
        encoding="utf-8",
    )
    runner.chmod(0o755)

    return _start_unit(args, job_id, unit, runner, output, quiet, delegate=True)


def _launch_cmd_job(
    args: argparse.Namespace,
    job_id: str,
    d: Path,
    cwd: str,
    unit: str,
    output: Path,
    quiet: bool,
    queued: bool = False,
) -> int:
    """A plain-command job: same unit, job dir, limits and Telegram surface as an
    agent job, but no model call. The caller (job_start tool / the owner's own
    shell) has already judged the command; the job runs with that authority and
    no extra bwrap, so poetry/pytest can use their caches."""
    py = shlex.quote(sys.executable)
    me = shlex.quote(str(Path(__file__).resolve()))
    ref = f"job:{job_id}"
    notify = ""
    if not quiet:
        notify = (
            'if [ $rc -eq 0 ]; then icon="✅"; else icon="❌"; fi\n'
            f"line=$({py} {me} oneline {shlex.quote(job_id)})\n"
            'msg="$icon '
            + f'{args.name}: $line"\n'
            + "sent=0\n"
            + "for i in $(seq 1 30); do\n"
            + f"  if {str(AGENTCTL)!r} notify --source bgjob --ref {ref} "
            + f"--profile {shlex.quote(args.profile)} "
            + f'{_notify_chat_flag(args)}"$msg" '
            + f">>{str(d / 'notify.log')!r} 2>&1; then sent=1; break; fi\n"
            + "  sleep 10\n"
            + "done\n"
            + 'if [ "$sent" != "1" ]; then echo "$msg" > '
            + f"{str(d / 'PENDING_NOTIFY')!r}; fi\n"
            + f"{me} pin --exclude {job_id} >/dev/null 2>&1 || true\n"
        )
    run = (
        f'/bin/bash -c "$(cat {str(d / "cmd.txt")!r})" '
        f"> {str(output)!r} 2>&1 < /dev/null\n"
        "rc=$?\n"
    )
    if queued:
        # Started with the cap full (--queue): wait for a slot first. On
        # timeout the command never runs; the ✅/❌ ping carries the reason.
        wait = f"{py} {me} wait-slot {shlex.quote(job_id)} 2> {str(output)!r}"
        run = f"if {wait}; then\n{run}else\n  rc={SLOT_TIMEOUT_RC}\nfi\n"
    tmp_head, tmp_tail = job_tmpdir_lines(d)
    runner = d / "run.sh"
    runner.write_text(
        "#!/bin/bash\n"
        'export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"\n'
        f"cd {cwd!r} || exit 1\n"
        + tmp_head
        + run
        + f'echo "$rc" > {str(d / "exit_code")!r}\n'
        f"{py} {me} summarize {shlex.quote(job_id)} >/dev/null 2>&1 || true\n"
        + notify
        + tmp_tail,
        encoding="utf-8",
    )
    runner.chmod(0o755)
    return _start_unit(args, job_id, unit, runner, output, quiet, queued=queued)


def _start_unit(
    args: argparse.Namespace,
    job_id: str,
    unit: str,
    runner: Path,
    output: Path,
    quiet: bool,
    delegate: bool = False,
    queued: bool = False,
) -> int:
    """Start run.sh as a transient unit and announce it (agent and --cmd jobs).

    delegate (agent jobs): the unit's cgroup is handed to run.sh, which carves
    box/agent and the test leaves out of it; see cgroup_carveout. --cmd jobs
    keep a plain unit: no box, the bus and testrun's scope stay usable."""
    mem = agent_unit_memory_max() if delegate else JOB_MEMORY_MAX
    if launcher.is_process(read_meta(job_id)):
        # dv-fe4d: no systemd here. The supervisor enforces the same cap,
        # softly; the env is ours, so the test cap and route vars carry over.
        try:
            launcher.start(job_dir(job_id), runner, _size_bytes(mem))
        except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
            sys.exit(f"error: job launcher failed: {exc}")
        return _announce_start(args, job_id, unit, output, quiet, queued)
    cmd = [
        "systemd-run",
        "--user",
        "--quiet",
        f"--unit={unit}",
        "--collect",
        f"--property=MemoryMax={mem}",
        *(["--property=Delegate=yes"] if delegate else []),
        "--property=CPUWeight=50",
        "--property=NoNewPrivileges=yes",
        # A transient unit gets the user manager's environment, not ours:
        # forward the test cap so scripts/testrun in the job sees it (dv-c5ac).
        *(
            [f"--setenv=PUMP_TEST_MEMORY_MAX={TEST_MEMORY_MAX}"]
            if TEST_MEMORY_MAX
            else []
        ),
        # The slot caps too: a job that launches jobs (the pump's merge job
        # starting its conflict agent) otherwise falls back to bgjob's default
        # cap of 2, counts itself, and is refused (gb-1ad9 merge, 04.11).
        *(
            f"--setenv={name}={os.environ[name]}"
            for name in ("BGJOB_MAX_CONCURRENT", "PUMP_MAX_CONCURRENT")
            if os.environ.get(name)
        ),
        # dv-d63d: agentjob resolves the job's route from models.yaml; the
        # table's path and the legacy PUMP_*_MODEL stage models set for
        # pump2 must reach it too.
        *(
            [
                f"--setenv={name}={os.environ[name]}"
                for name in ROUTE_ENV
                if os.environ.get(name)
            ]
            if delegate
            else []
        ),
        "/bin/bash",
        str(runner),
    ]
    r = subprocess.run(cmd, capture_output=True, text=True, env=_env())
    if r.returncode != 0:
        sys.exit(f"error: systemd-run failed: {r.stderr.strip()}")
    return _announce_start(args, job_id, unit, output, quiet, queued)


def _announce_start(
    args: argparse.Namespace,
    job_id: str,
    unit: str,
    output: Path,
    quiet: bool,
    queued: bool,
) -> int:
    """The start ping, the jobs pin and its watcher, the printed id."""

    # Announce the start HERE, not in the MCP wrapper. The finish ping already
    # lives in this script, and having the two on different layers meant a job
    # launched any way other than the job_start tool (a shell, another agent,
    # cron) silently produced no start message at all -- which is exactly the
    # "did it actually start?" ambiguity this whole mechanism exists to kill.
    started_at = datetime.now(UTC).strftime("%H:%M UTC")
    verb = "started"
    if queued:
        verb = f"queued: cap {MAX_CONCURRENT} full, starts when a slot frees"
    if not quiet:
        subprocess.run(
            [
                str(AGENTCTL),
                "notify",
                "--source",
                "bgjob",
                "--ref",
                f"job:{job_id}",
                "--profile",
                args.profile,
                *(
                    ["--chat-id", str(_notification_chat_id(args))]
                    if _notification_chat_id(args)
                    else []
                ),
                f'🚀 {args.profile} · job "{args.name}" {verb}\n'
                f"at {started_at}\nid: {job_id}",
            ],
            capture_output=True,
            text=True,
        )
        subprocess.run(
            [
                str(AGENTCTL),
                "notify",
                render_jobs_status(),
                "--source",
                "bgjob:status",
                "--pin-as",
                "jobs",
            ],
            capture_output=True,
            text=True,
        )
        # Keep the pin live rather than frozen at launch. Detached and
        # single-instance (flock in cmd_pin): a second job start finds the
        # lock held and returns immediately. It exits on its own once nothing
        # is running, so nothing has to clean it up.
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "pin", "--watch"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )

    print(f"{'queued' if queued else 'started'} {job_id}  (unit {unit})")
    print(f"  output: {output}")
    print(f"  status: bgjob status {job_id}")
    return 0


def _job_state(jid: str, meta: dict) -> str:
    unit = meta.get("unit", "")
    if job_active(jid, meta):
        if (job_dir(jid) / "QUEUED").exists():
            return "RUNNING (queued for a slot)"
        prog = "" if launcher.is_process(meta) else job_progress(unit)
        return f"RUNNING ({prog})" if prog else "RUNNING"
    ec = job_dir(jid) / "exit_code"
    rc = ec.read_text().strip() if ec.exists() else "?"
    return "done" if rc == "0" else f"failed(rc={rc})"


def cmd_list(args: argparse.Namespace) -> int:
    jobs = all_jobs()
    if not jobs:
        print("no jobs")
        return 0
    rows = [(jid, read_meta(jid)) for jid in jobs]
    states = {jid: _job_state(jid, meta) for jid, meta in rows}
    limit = getattr(args, "limit", None)
    older = 0
    if limit is not None:
        # All RUNNING first, then the newest `limit` finished (newest first).
        running = [r for r in rows if states[r[0]].startswith("RUNNING")]
        done = [r for r in rows if not states[r[0]].startswith("RUNNING")]
        older = max(0, len(done) - limit)
        rows = running + done[:limit]
    compact = getattr(args, "compact", False)
    for jid, meta in rows:
        out = job_dir(jid) / "output.md"
        size = out.stat().st_size if out.exists() else 0
        if compact:
            task = f" {meta['task']}" if meta.get("task") else ""
            print(f"{jid} {states[jid]} {size}B{task}")
        else:
            profile = meta.get("profile", "?")
            print(f"{jid:<34} {states[jid]:<32} {size:>7}B  {profile}")
    if older:
        print(f"+{older} older finished (job_list all=true)")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    meta = read_meta(args.id)
    if not meta:
        sys.exit(f"error: no such job: {args.id}")
    d = job_dir(args.id)
    running = unit_active(meta.get("unit", ""))
    print(json.dumps(meta, indent=2))
    print(f"running: {running}")
    if (d / "exit_code").exists():
        print(f"exit_code: {(d / 'exit_code').read_text().strip()}")
    if (d / "output.md").exists():
        print(f"output_bytes: {(d / 'output.md').stat().st_size}")
    return 0


def cmd_summarize(args: argparse.Namespace) -> int:
    record_job_limit(args.id)
    write_summary(args.id)
    return 0


def cmd_oneline(args: argparse.Namespace) -> int:
    try:
        text = (job_dir(args.id) / "output.md").read_text(errors="replace")
    except OSError:
        text = ""
    rc = ""
    try:
        rc = (job_dir(args.id) / "exit_code").read_text().strip()
    except OSError:
        pass
    line = cmd_oneline_text(text)
    print(line if rc in ("", "0") else f"rc={rc}: {line}")
    return 0


def cmd_output(args: argparse.Namespace) -> int:
    d = job_dir(args.id)
    p = d / "output.md"
    if not p.exists():
        sys.exit(f"error: no output for {args.id}")
    lines = p.read_text(encoding="utf-8", errors="replace").splitlines()
    if args.tail or args.full:
        for line in lines[-args.tail :] if args.tail else lines:
            print(line)
        return 0
    # Default: the short summary. A running job has no output yet (it is
    # written once at the end), so say so instead of printing nothing.
    if not (d / "exit_code").exists():
        print(
            f"job {args.id} is still running; no output yet. "
            "Use job_list / bgjob status."
        )
        return 0
    sf = d / "summary.md"
    summary = (
        sf.read_text(encoding="utf-8", errors="replace").strip()
        if sf.exists()
        else write_summary(args.id)  # job predates summaries
    )
    print(summary)
    print(f"[summary; full output: {len(lines)} lines, call with full=true]")
    return 0


def render_jobs_status(exclude: str | None = None) -> str:
    """Text for the pinned 'what is running now' post ('' when nothing is).

    `exclude` drops one job id from the render: the pin refresh at the end of
    run.sh executes INSIDE the finishing job's own unit, which is still
    `active` at that moment, so without the exclusion the just-finished job
    re-appears as running on every single finish.
    """
    lines = []
    for jid in all_jobs():
        if jid == exclude:
            continue
        meta = read_meta(jid)
        unit = meta.get("unit", "")
        if unit and unit_active(unit):
            bits = [b for b in (job_elapsed(jid), job_progress(unit)) if b]
            if (job_dir(jid) / "QUEUED").exists():
                bits = [b for b in (job_elapsed(jid), "queued") if b]
            tail = f" ({' · '.join(bits)})" if bits else ""
            prof = meta.get("profile", "?")
            lines.append(f"• {prof} · {meta.get('name', jid)}{tail}")
    if not lines:
        return ""
    stamp = datetime.now(UTC).strftime("%H:%M UTC")
    return (
        f"⏳ Background jobs running ({len(lines)})\n"
        + "\n".join(lines)
        + f"\nupdated {stamp}"
    )


def _push_pin(text: str) -> int:
    r = subprocess.run(
        [str(AGENTCTL), "notify", text, "--source", "bgjob:status", "--pin-as", "jobs"],
        capture_output=True,
        text=True,
    )
    return r.returncode


def cmd_pin(args: argparse.Namespace) -> int:
    """Push the current status into the pinned post (empty retires it).

    With --watch, keep re-pushing while anything is running, so the pin shows
    a live elapsed/CPU figure instead of a snapshot frozen at launch. The
    notification service edits the existing message in place (keyed by
    (chat_id, pin_as)), so a refresh costs one editMessageText and never a new
    post. Single-instance: two jobs starting back to back must not spawn two
    watchers both editing the same message.
    """
    if not getattr(args, "watch", False):
        rc = _push_pin(render_jobs_status(exclude=args.exclude))
        return 0 if rc == 0 else 1

    import fcntl
    import time

    JOBS_ROOT.mkdir(parents=True, exist_ok=True)
    lock = open(JOBS_ROOT / ".pinwatch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # another watcher owns the pin

    last = None
    # Bounded so a wedged watcher can never edit the pin forever.
    deadline = time.monotonic() + args.max_hours * 3600
    while time.monotonic() < deadline:
        text = render_jobs_status()
        if text != last:
            _push_pin(text)
            last = text
        if not text:
            return 0  # nothing running: pin retired, we are done
        time.sleep(args.interval)
    return 0


def cmd_flush(_args: argparse.Namespace) -> int:
    """Deliver notifications that failed while the bot was down.

    A job that finishes during a bot restart cannot reach the HTTP API, so it
    leaves a PENDING_NOTIFY marker. This drains those, so a completed job is
    never silently lost -- run it after a restart (or from the agent when it
    notices jobs finished while it was away).
    """
    pending = [j for j in all_jobs() if (job_dir(j) / "PENDING_NOTIFY").exists()]
    if not pending:
        print("no pending notifications")
        return 0
    for jid in pending:
        marker = job_dir(jid) / "PENDING_NOTIFY"
        msg = marker.read_text(encoding="utf-8").strip()
        r = subprocess.run(
            [str(AGENTCTL), "notify", "--source", "bgjob", "--markdown", msg],
            capture_output=True,
            text=True,
        )
        if r.returncode == 0:
            marker.unlink()
            print(f"delivered {jid}")
        else:
            print(f"still failing {jid}: {r.stderr.strip()[:120]}")
    return 0


def cmd_cancel(args: argparse.Namespace) -> int:
    meta = read_meta(args.id)
    if not meta:
        sys.exit(f"error: no such job: {args.id}")
    if launcher.is_process(meta):
        launcher.cancel(job_dir(args.id))
    else:
        subprocess.run(
            ["systemctl", "--user", "stop", meta["unit"]],
            capture_output=True,
            env=_env(),
        )
    print(f"cancelled {args.id}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="bgjob", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("run", help="start a detached job")
    p.add_argument("prompt", nargs="?", default=None)
    p.add_argument(
        "--cmd",
        metavar="COMMAND",
        help="run this shell command instead of a model turn (e.g. the full "
        "test suite). Same unit/limits/Jobs ping; summary = exit code + tail.",
    )
    p.add_argument("--profile", default="general")
    p.add_argument("--name", default="job")
    p.add_argument(
        "--model",
        default=None,
        help="explicit Claude model for the run. Default: the job route's "
        "model from config/models.yaml `jobs:` (built-in: sonnet, the cost "
        "floor for background work). Ignored, with a log line, when the "
        "route is not Claude on the subscription.",
    )
    p.add_argument(
        "--harness",
        default=None,
        choices=["claude"],
        help="run this one job on Claude over the owner's jobs switch "
        "(dv-a8e4). Explicit only: a failed Codex job is never retried on it.",
    )
    p.add_argument(
        "--route",
        default=None,
        metavar="NAME",
        help="job route row in config/models.yaml `jobs:` (harness, provider, "
        "model): background_job (default), monitor, pump_<stage>",
    )
    p.add_argument(
        "--allow-dir",
        action="append",
        metavar="DIR",
        help="extra directory the job may WRITE to (repeatable). The job dir "
        "and the profile working dir are always writable; everything else on "
        "the filesystem is read-only.",
    )
    p.add_argument(
        "--cwd",
        metavar="DIR",
        help="run in this directory instead of the profile's working_dir, and "
        "make it the writable root. Used by pump2 to run a job in a git "
        "worktree so an unattended agent never edits the tree the live bot "
        "imports from.",
    )
    p.add_argument(
        "--quiet",
        action="store_true",
        help="send no Telegram start/finish/pin messages and skip the digest "
        "turn. For jobs whose caller does its own reporting (pump2); a "
        "job that pings twice from two layers is worse than one that pings "
        "once from the layer that knows what the message should say.",
    )
    p.add_argument(
        "--task",
        metavar="ID",
        help="board ticket id (dv-xxxx); the job is told to read it itself. "
        "Read from this repo's .deviz/tasks.",
    )
    p.add_argument(
        "--force",
        action="store_true",
        help="start even if a job with the same name or task is running or "
        "finished within the last 30 minutes",
    )
    p.add_argument(
        "--batch",
        metavar="ID",
        default=None,
        help="batch id (job_start passes the agent turn id): jobs sharing it "
        "are reported in one digest in the agent's chat",
    )
    p.add_argument("--user-id", type=int, default=None)
    p.add_argument("--chat-id", type=int, default=None)
    p.add_argument(
        "--ask-context",
        metavar="JSON",
        default=None,
        help="model-turn jobs only: {task_id, task_title, stage} handed to "
        "agentjob for the ask card's explainer (pump2, dv-781f)",
    )
    p.add_argument(
        "--queue",
        action="store_true",
        help="--cmd jobs only: with the job cap full, start anyway and wait "
        "(up to 2h) for a slot instead of being refused. Used by job_start "
        "for command jobs (release check, full suite).",
    )
    p.add_argument(
        "--setting-sources",
        metavar="LIST",
        default=None,
        help="comma list of CLI setting sources for the model turn (default: "
        "agentjob's user,project). pump2 passes 'project' so stages get "
        "no user plugins, skills or hooks (dv-fe02).",
    )
    p.add_argument(
        "--pre-cmd",
        metavar="COMMAND",
        default=None,
        help="model-turn jobs only: run this shell command in the job's box "
        "BEFORE the turn, to completion (no 600 s Bash cap). pump2 runs a "
        "board's acceptance command this way (dv-2514).",
    )
    p.add_argument(
        "--pre-log",
        metavar="FILE",
        default=None,
        help="--pre-cmd's stdout+stderr; last line 'pre-step: exit N after …'",
    )
    p.add_argument(
        "--pre-timeout",
        metavar="SECONDS",
        type=int,
        default=PRE_TIMEOUT_S,
        help="hang guard for --pre-cmd (default 3600): past it the command is "
        "killed, `pre_timed_out` is written and the turn does not run",
    )
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("wait-slot", help="wait for a job slot (queued jobs' run.sh)")
    p.add_argument("id")
    p.set_defaults(fn=cmd_wait_slot)

    p = sub.add_parser("digest", help="digest a finished job's batch if complete")
    p.add_argument("id")
    p.set_defaults(fn=cmd_digest)

    p = sub.add_parser("digest-watch", help="wait for a batch, then digest it")
    p.add_argument("batch")
    p.set_defaults(fn=cmd_digest_watch)

    p = sub.add_parser("list", help="list jobs")
    p.add_argument("--compact", action="store_true", help="one short line per job")
    p.add_argument(
        "--limit",
        type=int,
        default=None,
        help="all RUNNING jobs plus the newest N finished",
    )
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("status", help="show one job")
    p.add_argument("id")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("output", help="print job output")
    p.add_argument("id")
    p.add_argument("--tail", type=int, default=0)
    p.add_argument("--full", action="store_true", help="whole output, not summary")
    p.set_defaults(fn=cmd_output)

    p = sub.add_parser(
        "limit-notice", help="tell the job's agent chat about its usage limit, once"
    )
    p.add_argument("id")
    p.set_defaults(fn=cmd_limit_notice)

    p = sub.add_parser("summarize", help="write summary.md for a finished job")
    p.add_argument("id")
    p.set_defaults(fn=cmd_summarize)

    p = sub.add_parser("oneline", help="one-line result of a --cmd job")
    p.add_argument("id")
    p.set_defaults(fn=cmd_oneline)

    p = sub.add_parser("pin", help="refresh the pinned running-jobs status post")
    p.add_argument(
        "--exclude",
        metavar="JOB_ID",
        default=None,
        help="treat this job as not-running (used by a finishing job whose "
        "unit is still active while it refreshes the pin)",
    )
    p.add_argument(
        "--watch",
        action="store_true",
        help="keep refreshing the pin while jobs run, then exit when none are",
    )
    p.add_argument("--interval", type=int, default=90, help="--watch period, seconds")
    p.add_argument(
        "--max-hours", type=float, default=12.0, help="--watch safety deadline"
    )
    p.set_defaults(fn=cmd_pin)

    p = sub.add_parser("flush", help="deliver notifications missed while bot was down")
    p.set_defaults(fn=cmd_flush)

    p = sub.add_parser("cancel", help="stop a running job")
    p.add_argument("id")
    p.set_defaults(fn=cmd_cancel)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
