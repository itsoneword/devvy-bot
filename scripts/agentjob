#!/usr/bin/env python3
"""agentjob — one unattended agent turn through the model router (dv-ef90).

What `scripts/bgjob` and the server monitor run instead of a bare CLI call with
every permission bypassed: the same tool-call policy as
chat turns, asks sent to the owner over the bot, and a `model_calls` row.

Usage:
  agentjob --profile devops --prompt-file prompt.txt [--cwd DIR] [--model sonnet]
           [--route pump_review] [--name NAME] [--purpose background_job|monitor]
           [--session-file PATH]
           [--ask-context '{"task_id": ..., "task_title": ..., "stage": ...}']
  agentjob --print-route [--route NAME] [--model M]   # resolved route as JSON

The job's harness, provider and model come from the `jobs:` rows of
config/models.yaml (dv-d63d; read here, so an edit applies to the next job).
`--route` names the row (default: background_job, or monitor for
--purpose monitor); `--model` beats it only on the Claude subscription.

The answer goes to stdout; the exit code is 0 on success, 3 when work the job
started was still running at its end (dv-b6dd). Needs the bot's
poetry environment; re-executes itself in it when started with another python.
"""

from __future__ import annotations

import argparse
import asyncio
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def _reexec_in_venv() -> None:
    """Scripts and cron start us with the system python; the SDK lives in the
    poetry venv. Find it once and re-exec."""
    if os.environ.get("AGENTJOB_REEXEC"):
        sys.exit("error: claude_agent_sdk not importable even in the poetry venv")
    poetry = os.environ.get("POETRY_BIN") or "poetry"
    try:
        venv = subprocess.run(
            [poetry, "env", "info", "-p"],
            cwd=str(REPO),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        sys.exit(f"error: cannot locate the poetry venv ({exc})")
    python = Path(venv) / "bin" / "python"
    os.environ["AGENTJOB_REEXEC"] = "1"
    os.execv(str(python), [str(python), *sys.argv])


try:
    import claude_agent_sdk  # noqa: F401
except ImportError:
    home_poetry = Path.home() / ".local/bin/poetry"
    if "POETRY_BIN" not in os.environ and home_poetry.exists():
        os.environ["POETRY_BIN"] = str(home_poetry)
    _reexec_in_venv()

sys.path.insert(0, str(REPO))

import structlog  # noqa: E402

# stdout is the answer (bgjob appends it to output.md); every log line goes to
# stderr, including the loader's and the registry's.
structlog.configure(logger_factory=structlog.PrintLoggerFactory(file=sys.stderr))

import json  # noqa: E402

from src.model_router.job import (  # noqa: E402
    JobSpec,
    bot_link_from_env,
    parse_ask_context,
    pump_worktree_root,
    run_job,
)
from src.model_router.routes import process_call_routes  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--profile", help="profile slug (policy flags)")
    ap.add_argument("--prompt-file", type=Path)
    ap.add_argument("--cwd", type=Path, default=None, help="default: the profile's")
    ap.add_argument(
        "--model",
        default=None,
        help="explicit Claude model; default: the job route's (models.yaml jobs:)",
    )
    ap.add_argument(
        "--route",
        default=None,
        help="job route row in models.yaml jobs: (default: background_job, "
        "or monitor for --purpose monitor)",
    )
    ap.add_argument(
        "--print-route",
        action="store_true",
        help="print the resolved route as JSON and exit",
    )
    ap.add_argument("--name", default="job")
    ap.add_argument("--purpose", default="background_job", choices=["background_job", "monitor"])
    ap.add_argument(
        "--setting-sources",
        default="user,project",
        help="comma list of CLI setting sources; taskpump stages pass 'project'",
    )
    ap.add_argument(
        "--ask-context",
        default=None,
        help="JSON {task_id, task_title, stage} for the ask explainer (dv-781f)",
    )
    ap.add_argument(
        "--session-file",
        type=Path,
        default=None,
        help="write the turn's session id here (LLM Analytics job link)",
    )
    ap.add_argument(
        "--ignore-quota",
        action="store_true",
        help="start even while a usage limit is recorded (bgjob run --force)",
    )
    args = ap.parse_args()

    try:
        route = process_call_routes().resolve_job(
            args.route or args.purpose, model=args.model
        )
    except ValueError as exc:
        sys.exit(f"error: {exc}")
    if args.print_route:
        print(
            json.dumps(
                {
                    "harness": route.harness,
                    "provider": route.provider,
                    "model": route.model,
                }
            )
        )
        return 0
    if not args.profile or not args.prompt_file:
        ap.error("--profile and --prompt-file are required")
    print(
        f"agentjob: route={args.route or args.purpose} "
        f"{route.harness}/{route.provider}/{route.model}",
        file=sys.stderr,
    )

    # dv-7ad9: a usage limit recorded by an earlier job and not reset yet.
    # Starting the turn would only hit it again: end the way a limit hit
    # ends (exit QUOTA_EXIT plus the quota line), without a model call.
    from src.model_router import quota

    # Only a Claude-subscription route is stopped by Claude's limit; a job
    # moved to Codex/OpenRouter (dv-d63d) goes ahead.
    on_claude = route.harness == "claude"
    limit = None if args.ignore_quota or not on_claude else quota.active()
    if limit is not None:
        print(f"agentjob failed: {limit.message} (recorded, not retried)", file=sys.stderr)
        print(quota.quota_line(limit), file=sys.stderr)
        return quota.QUOTA_EXIT

    from src.config.loader import load_config
    from src.profiles import load_profile_registry

    config = load_config(config_file=REPO / ".env")
    if config.profiles_config_path is None:
        sys.exit("error: PROFILES_CONFIG_PATH is not set")
    registry = load_profile_registry(
        config.profiles_config_path,
        sandbox_default=config.sandbox_enabled,
        data_root=config.devvy_data_root,
    )
    profile = registry.get_by_slug(args.profile)
    if profile is None:
        sys.exit(f"error: unknown profile '{args.profile}'")
    sandbox = profile.sandbox if profile.sandbox is not None else config.sandbox_enabled
    cwd = (args.cwd or profile.working_dir).expanduser().resolve()
    if not cwd.is_dir():
        sys.exit(f"error: working dir does not exist: {cwd}")
    # dv-58db: a pump worktree is disposable; deleting inside it needs no ask.
    free_root = pump_worktree_root(cwd)
    print(f"agentjob: free_root={free_root}", file=sys.stderr)

    sources = tuple(s.strip() for s in args.setting_sources.split(",") if s.strip())
    unknown = [s for s in sources if s not in ("user", "project", "local")]
    if unknown:
        sys.exit(f"error: unknown setting source(s): {', '.join(unknown)}")

    spec = JobSpec(
        purpose=args.purpose,
        name=args.name,
        prompt=args.prompt_file.read_text(encoding="utf-8"),
        model=route.model or "sonnet",
        route=route,
        working_directory=cwd,
        full_access=not sandbox,
        unrestricted=bool(profile.unrestricted),
        profile=profile.slug,
        cli_path=config.claude_cli_path or None,
        free_root=free_root,
        setting_sources=sources,  # type: ignore[arg-type]
        ask_context=parse_ask_context(args.ask_context),
        session_file=args.session_file,
        # A confined Codex job writes these too (dv-d63d); --cwd jobs (pump
        # worktrees) keep their explicit write set, as in the bgjob box.
        extra_dirs=() if args.cwd else tuple(profile.extra_dirs or ()),
    )
    return asyncio.run(run_job(spec, bot_link_from_env(REPO)))


if __name__ == "__main__":
    sys.exit(main())
