#!/usr/bin/env python3
"""trace — print a model call's harness trace (dv-2260): the question, the
answer and the tool-call tree, subagent calls under their Agent call.

Usage:
  scripts/trace            newest turn (bot, pump or bgjob)
  scripts/trace 1234       model_calls row 1234 (the id /trace and jobs show)
  scripts/trace --list     the last 20 turns with their ids

Reads ``bot.db`` under DEVVY_DATA_ROOT (else the configured data root); never
writes it (no migrations, no prune). The owner's ``/trace`` in Telegram shows
the same text.
"""

from __future__ import annotations

import argparse
import asyncio
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def _reexec_in_venv() -> None:
    """Started with the system python: re-exec in the bot's poetry venv."""
    if os.environ.get("TRACE_REEXEC"):
        sys.exit("error: bot dependencies not importable even in the poetry venv")
    poetry = os.environ.get("POETRY_BIN") or "poetry"
    home_poetry = Path.home() / ".local/bin/poetry"
    if "POETRY_BIN" not in os.environ and home_poetry.exists():
        poetry = str(home_poetry)
    try:
        venv = subprocess.run(
            [poetry, "env", "info", "-p"],
            cwd=str(REPO),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        sys.exit(f"error: cannot locate the poetry venv ({exc})")
    python = Path(venv) / "bin" / "python"
    os.environ["TRACE_REEXEC"] = "1"
    os.execv(str(python), [str(python), *sys.argv])


try:
    import aiosqlite  # noqa: F401
    import sqlalchemy  # noqa: F401
except ImportError:
    _reexec_in_venv()

sys.path.insert(0, str(REPO))

import structlog  # noqa: E402

structlog.configure(logger_factory=structlog.PrintLoggerFactory(file=sys.stderr))

from src.model_router.trace_view import render_trace  # noqa: E402
from src.storage.database import DatabaseManager  # noqa: E402
from src.storage.tool_calls import ToolCallRepository  # noqa: E402
from src.utils.paths import data_layout, sqlite_url  # noqa: E402


async def _run(args: argparse.Namespace) -> int:
    db_path = data_layout().bot_db
    if not db_path.is_file():
        print(f"error: no bot.db at {db_path}", file=sys.stderr)
        return 2
    # A bare DatabaseManager: initialize() would run migrations (writes).
    db = DatabaseManager(sqlite_url(db_path))
    repo = ToolCallRepository(db)
    try:
        if args.list:
            for call in await repo.recent_turns(args.list):
                print(
                    f"#{call['id']}  {str(call['ts'])[:19]}  {call['purpose']}"
                    f"  {call.get('profile') or '-'}  {call['outcome']}"
                    f"  tools={call['tool_count']}"
                )
            return 0
        call_id = args.id if args.id is not None else await repo.latest_turn_id()
        if call_id is None:
            print("No traced turns yet.")
            return 0
        trace = await repo.trace(call_id)
        if trace is None:
            print(f"No model call #{call_id}.", file=sys.stderr)
            return 1
        print(render_trace(trace).text)
        return 0
    finally:
        await db.close()


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("id", nargs="?", type=int, help="model_calls id")
    ap.add_argument(
        "--list", nargs="?", type=int, const=20, help="list the last N turns"
    )
    return asyncio.run(_run(ap.parse_args()))


if __name__ == "__main__":
    sys.exit(main())
