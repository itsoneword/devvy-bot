# Devvy -- configuration reference
#
# GENERATED FILE. Do not edit by hand: run `make env-example` (which runs
# scripts/gen_env_example.py) after changing src/config/settings.py. CI fails
# if this file and the settings model disagree.
#
# Every variable below is optional and shown with its built-in default,
# EXCEPT the few that are left uncommented. Uncommenting a line pins that
# value for good, so only uncomment what you actually want to change.
#
# ./install.sh writes a real .env from this file. You only need to edit it by
# hand if you are installing manually -- see docs/installation.md.

# === Bot settings ===

# Telegram bot token from BotFather  [required]
# install.sh --token writes this for you.
TELEGRAM_BOT_TOKEN=

# Bot username without @  [required]
TELEGRAM_BOT_USERNAME=

# === Security ===

# Base directory for projects. If unset, denylist mode is used.  [path]
# Leave unset for denylist mode (recommended). Setting it to a directory that
# does not exist stops the bot from starting.
# APPROVED_DIRECTORY=

# Allowed Telegram user IDs (owner role)  [comma-separated ints]
# install.sh captures your id (it waits for your /start). An EMPTY list does
# not mean 'allow everyone': with no owner and no guest the bot refuses to
# start.
ALLOWED_USERS=

# Guest Telegram user IDs (restricted role). Effective whitelist is the union
# with allowed_users; an ID in both lists is an owner.  [comma-separated ints]
# GUEST_USERS=

# Maximum members per family (owner-protection cap for guest-initiated /family
# add)  [int]
# FAMILY_MAX_MEMBERS=3

# Enable token-based authentication  [true/false]
# ENABLE_TOKEN_AUTH=false

# Secret for auth tokens  [secret]
# install.sh generates one. openssl rand -hex 32.
# AUTH_TOKEN_SECRET=

# === Security relaxation (for trusted environments) ===

# Disable dangerous pattern validation (pipes, redirections, etc.)
# [true/false]
# DISABLE_SECURITY_PATTERNS=false

# Allow all Claude tools by bypassing tool validation checks  [true/false]
# DISABLE_TOOL_VALIDATION=false

# === Claude settings ===

# Path to Claude CLI binary (deprecated)  [text]
# CLAUDE_BINARY_PATH=

# Path to Claude CLI executable  [text]
# CLAUDE_CLI_PATH=

# Anthropic API key for SDK (optional if CLI logged in)  [secret]
# One of the three ways to give the bot an LLM login; the other two are
# 'claude auth login' at install time and /auth in Telegram. Leave empty if
# the claude CLI is already logged in.
ANTHROPIC_API_KEY=

# Claude model to use (defaults to CLI default if unset)  [text]
# CLAUDE_MODEL=

# Max conversation turns  [int]
# CLAUDE_MAX_TURNS=10

# Claude timeout  [int]
# CLAUDE_TIMEOUT_SECONDS=300

# Max bytes for a single SDK stream-json message (stdout)  [int]
# CLAUDE_MAX_BUFFER_SIZE=16777216

# Max cost per user  [number]
# CLAUDE_MAX_COST_PER_USER=10.0

# Max daily cost for guest-role users  [number]
# CLAUDE_MAX_COST_PER_USER_GUEST=2.0

# Max cost per individual request (SDK budget cap)  [number]
# CLAUDE_MAX_COST_PER_REQUEST=5.0

# Per-user daily budget overrides as 'telegram_id:usd' pairs, comma-separated
# (e.g. '111:100,222:50'). Takes precedence over the role-tier caps.  [comma-
# separated id:value pairs]
# CLAUDE_COST_LIMIT_OVERRIDES=

# Alert admin if a user's spend in a rolling hour exceeds this  [number]
# WATCHDOG_MAX_COST_PER_HOUR=20.0

# Alert admin if a user's completed turns in a rolling hour exceed this  [int]
# WATCHDOG_MAX_MESSAGES_PER_HOUR=60

# Alert admin if a user's summed SDK turns in a rolling hour exceed this
# [int]
# WATCHDOG_MAX_TURNS_PER_HOUR=100

# Default agent backend for Telegram turns  [claude | openai_codex]
# AGENT_BACKEND=claude

# Default model override for the selected agent backend  [text]
# AGENT_MODEL=

# Timeout for non-Claude agent backend requests  [int]
# AGENT_TIMEOUT_SECONDS=600

# Model alias for the memory evaluator's Claude CLI call (e.g. 'sonnet',
# 'haiku', or a full model id).  [text]
# EVALUATOR_MODEL=sonnet

# Strip the Claude Code harness (project settings, skills, MCP servers, tools,
# default system prompt) from evaluator CLI calls.  [true/false]
# EVALUATOR_LEAN_CONTEXT=true

# Hard cap on the conversation slice sent to one evaluator run. Over this, the
# oldest messages are dropped (most recent kept).  [int]
# EVALUATOR_MAX_DELTA_CHARS=120000

# Ceiling for one evaluator/reconciler CLI call; timeouts kill the subprocess
# and are recorded as failures, never as [].  [int]
# EVALUATOR_TIMEOUT_SECONDS=120

# Reject episodic (meal/day-summary-shaped) evaluator candidates before
# reconciliation (EVALUATOR_EPISODIC_GUARD).  [true/false]
# EVALUATOR_EPISODIC_GUARD=true

# Run the daily guard+judge review of newly-saved memory facts and report to
# the owner (FACT_QUALITY_CHECK_ENABLED). Never writes.  [true/false]
# FACT_QUALITY_CHECK_ENABLED=false

# Cron schedule for the daily fact-quality check (FACT_QUALITY_CHECK_CRON).
# [text]
# FACT_QUALITY_CHECK_CRON=0 7 * * *

# Model alias for the daily fact-quality judge call
# (FACT_QUALITY_CHECK_MODEL).  [text]
# FACT_QUALITY_CHECK_MODEL=haiku

# Detect reply text claiming a memory/file write with no backing tool call;
# log + inform the owner (SAVE_CLAIM_CHECK_ENABLED).  [true/false]
# SAVE_CLAIM_CHECK_ENABLED=true

# Local JSON token store for OpenAI Codex OAuth credentials  [path]
# OPENAI_CODEX_CREDENTIALS_PATH=data/model_auth/openai_codex.json

# JSON store of Codex thread ids per (user, working_dir)  [path]
# CODEX_SESSION_STORE_PATH=data/codex_sessions.json

# List of allowed Claude tools  [comma-separated]
# CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,LS,Task,TaskOutput,MultiEdit,NotebookRead,NotebookEdit,WebFetch,TodoRead,TodoWrite,WebSearch,Skill

# List of explicitly disallowed Claude tools/commands  [comma-separated]
# CLAUDE_DISALLOWED_TOOLS=AskUserQuestion

# === Sandbox settings ===

# Enable OS-level bash sandboxing for approved dir  [true/false]
# SANDBOX_ENABLED=true

# Commands that run outside the sandbox (need system access)  [comma-
# separated]
# SANDBOX_EXCLUDED_COMMANDS=git,npm,pip,poetry,make,docker

# === Rate limiting ===

# Requests per window  [int]
# RATE_LIMIT_REQUESTS=10

# Rate limit window seconds  [int]
# RATE_LIMIT_WINDOW=60

# Burst capacity  [int]
# RATE_LIMIT_BURST=20

# === Storage ===

# Database connection URL  [text]
# DATABASE_URL=sqlite:///data/bot.db

# Per-user data store (data.db, dv-5f3a): logs, products, portions, issues,
# docs — separate file from bot.db  [text]
# USER_DATABASE_URL=sqlite:///data/data.db

# IANA timezone defining the user's day boundary for the today-state digest
# and the evening gap-ping  [text]
# USER_TIMEZONE=Europe/Lisbon

# Directory holding the deviz task board markdown files  [path]
# DEVIZ_TASKS_DIR=.deviz/tasks

# Session timeout  [int]
# SESSION_TIMEOUT_HOURS=24

# Session timeout in minutes  [int]
# SESSION_TIMEOUT_MINUTES=120

# Max concurrent sessions  [int]
# MAX_SESSIONS_PER_USER=5

# === Features ===

# Enable Model Context Protocol  [true/false]
# ENABLE_MCP=false

# MCP configuration file path  [path]
# MCP_CONFIG_PATH=

# Enable file upload handling  [true/false]
# ENABLE_FILE_UPLOADS=true

# Enable voice message transcription  [true/false]
# ENABLE_VOICE_MESSAGES=true

# Voice transcription provider: 'mistral', 'openai', 'elevenlabs', or
# 'whisper' (local)  [mistral | openai | whisper | elevenlabs]
# VOICE_PROVIDER=mistral

# Local Whisper model size: 'tiny', 'base', 'small', 'medium', 'large-v3'.
# Smaller models are faster but less accurate.  [text]
# WHISPER_MODEL=base

# Mistral API key for voice transcription  [secret]
# MISTRAL_API_KEY=

# OpenAI API key for Whisper voice transcription  [secret]
# OPENAI_API_KEY=

# ElevenLabs API key for Scribe voice transcription  [secret]
# ELEVENLABS_API_KEY=

# Model for voice transcription. Defaults to 'voxtral-mini-latest' (Mistral),
# 'whisper-1' (OpenAI) or 'scribe_v2' (ElevenLabs)  [text]
# VOICE_TRANSCRIPTION_MODEL=

# Maximum Telegram voice message size (MB) that will be downloaded for
# transcription  [int]
# VOICE_MAX_FILE_SIZE_MB=20

# Domain vocabulary passed to the transcription provider's hint/bias parameter
# to reduce misrecognition of jargon and proper nouns  [comma-separated]
# VOICE_VOCABULARY_HINTS=Claude,Anthropic,Sonnet,Opus,Haiku

# ISO-639-1 language code of voice messages (e.g. 'en'). Pinning the language
# skips auto-detection and improves accuracy on short clips. None = auto-
# detect.  [text]
# VOICE_LANGUAGE=

# Enable soul and memory system  [true/false]
# ENABLE_SOUL_MEMORY=false

# Path to memory directory (relative to approved_directory or absolute)
# [path]
# MEMORY_PATH=data/memory

# Path to soul.md personality file (relative to approved_directory or
# absolute)  [path]
# SOUL_MD_PATH=data/soul.md

# Maximum lines in activity.md before rotation  [int]
# ACTIVITY_LOG_MAX_LINES=200

# When a resumed CLI transcript dropped a pure-prose assistant turn (no
# committed text and no tool_use; back-filled with a synthetic placeholder),
# prepend a recap of recent stored responses so the model keeps continuity.
# Targets chat-style personas; tool-driven turns are unaffected.  [true/false]
# HEAL_LOST_CONTEXT=true

# Run the memory evaluator each time the conversation's real context crosses
# another multiple of this many tokens.  [int]
# WINDOW_EVAL_INTERVAL_TOKENS=120000

# Roll the conversation window (fresh backend session seeded with the recent
# tail) once real context reaches this many tokens.  [int]
# WINDOW_REFRESH_THRESHOLD_TOKENS=320000

# Character budget for the facts snapshot inside a frozen window bundle;
# exceeding it triggers a memory consolidation pass.  [int]
# BUNDLE_FACTS_BUDGET_CHARS=12000

# === Reply quoting ===

# Quote the original user message when replying. Set to false for cleaner
# thread-based conversations.  [true/false]
# REPLY_QUOTE=true

# === Output verbosity (0=quiet, 1=normal, 2=detailed) ===

# Bot output verbosity: 0=quiet (final response only), 1=normal (tool names +
# reasoning), 2=detailed (tool inputs + longer reasoning)  [int]
# VERBOSE_LEVEL=1

# === Streaming drafts (Telegram sendMessageDraft) ===

# Stream partial responses via sendMessageDraft (private chats only)
# [true/false]
# ENABLE_STREAM_DRAFTS=false

# Minimum seconds between draft updates (0.1-5.0)  [number]
# STREAM_DRAFT_INTERVAL=0.3

# === Monitoring ===

# Logging level  [text]
# LOG_LEVEL=INFO

# Enable anonymous telemetry  [true/false]
# ENABLE_TELEMETRY=false

# Sentry DSN for error tracking  [text]
# SENTRY_DSN=

# === Development ===

# Enable debug mode  [true/false]
# DEBUG=false

# Enable development features  [true/false]
# DEVELOPMENT_MODE=false

# Accept EVERY Telegram user as an owner. There is no other gate behind this —
# anyone who finds the bot gets full access. Only ever true on a throwaway
# local bot; DEVELOPMENT_MODE alone no longer does this (dv-5c83).
# [true/false]
# DANGEROUSLY_ALLOW_ALL_USERS=false

# === Webhook settings (optional) ===

# Webhook URL for bot  [text]
# WEBHOOK_URL=

# Webhook port  [int]
# WEBHOOK_PORT=8443

# Webhook path  [text]
# WEBHOOK_PATH=/webhook

# === Agentic platform settings ===

# Enable FastAPI webhook server  [true/false]
# ENABLE_API_SERVER=false

# Webhook API bind address. Set 0.0.0.0 to accept external webhooks (put a
# reverse proxy in front).  [text]
# API_SERVER_HOST=127.0.0.1

# Webhook API server port  [int]
# API_SERVER_PORT=8080

# Enable job scheduler  [true/false]
# ENABLE_SCHEDULER=false

# GitHub webhook HMAC secret  [text]
# GITHUB_WEBHOOK_SECRET=

# Shared secret for generic webhook providers  [text]
# install.sh generates one. openssl rand -hex 32.
# WEBHOOK_API_SECRET=

# Default Telegram chat IDs for proactive notifications  [comma-separated
# ints]
# NOTIFICATION_CHAT_IDS=

# Profile slug that receives 'health' provider webhooks (e.g. Apple Health via
# Health Auto Export). Ignored if that slug doesn't exist in the profile
# registry -- falls back to the default working dir.  [text]
# HEALTH_EXPORT_PROFILE_SLUG=coach

# Telegram user id that owns imported health data (memory scope + reply
# target). In a private chat this doubles as the chat id. Unset falls back to
# the first ALLOWED_USERS entry.  [int]
# HEALTH_EXPORT_USER_ID=

# Enable strict routing by Telegram forum project threads  [true/false]
# ENABLE_PROJECT_THREADS=false

# Project thread mode: private chat topics or group forum topics  [private |
# group]
# PROJECT_THREADS_MODE=private

# Telegram forum chat ID where project topics are managed  [int]
# PROJECT_THREADS_CHAT_ID=

# Path to YAML project registry for thread mode  [path]
# PROJECTS_CONFIG_PATH=

# Path to profiles YAML registry. If unset, single-profile mode.  [path]
# install.sh points this at config/profiles.yaml. Unset = single-profile mode.
# PROFILES_CONFIG_PATH=

# Minimum delay between Telegram API calls during project topic sync  [number]
# PROJECT_THREADS_SYNC_ACTION_INTERVAL_SECONDS=1.1

# === Environment selection (read by src/config/loader.py) ===

# development, testing or production. Chooses the defaults in
# src/config/environments.py.
# ENVIRONMENT=development

# === Channel KB MCP daemon (read by src/channel_intel/config.py) ===

# Bind address for the daemon.
# CHANNEL_INTEL_HOST=127.0.0.1

# Bind port.
# CHANNEL_INTEL_PORT=8765

# Its SQLite file.
# CHANNEL_INTEL_DB_PATH=data/channel_intel.db

# Bearer token shared by the bot seam and the daemon. openssl rand -hex 32.
# CHANNEL_INTEL_TOKEN=
